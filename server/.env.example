# Port the HTTP server listens on.
PORT=4000

# SQLite database file. Relative paths are resolved against server/.
DB_PATH=./data/app.db

# Allowed CORS origin(s) for the Expo web dev server, comma-separated.
CORS_ORIGIN=http://localhost:8081

# Interface to bind. 0.0.0.0 is required in a container. Default is 0.0.0.0.
HOST=0.0.0.0

# On Fly the database lives on the volume, not in the image:
# DB_PATH=/data/app.db
