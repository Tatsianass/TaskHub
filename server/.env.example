# Port the HTTP server listens on.
PORT=4000

# PostgreSQL connection string (required). `npm run db` at the repo root starts a local one.
# TLS: verified by default when NODE_ENV=production. Append ?sslmode=disable to turn it off, or
# ?sslmode=no-verify for providers with a self-signed certificate.
DATABASE_URL=postgres://todo:todo@localhost:5432/todo

# Max connections in the pool.
PG_POOL_MAX=10

# Allowed CORS origin(s) for the Expo web dev server, comma-separated.
CORS_ORIGIN=http://localhost:8081

# Interface to bind. 0.0.0.0 is required in a container. Default is 0.0.0.0.
HOST=0.0.0.0

# On Fly, set DATABASE_URL as a secret: fly secrets set DATABASE_URL=...

# Proxy hops in front of the server, so rate limits see the real client IP.
# Fly = 1. Leave 0 when clients connect directly.
TRUST_PROXY=0

# Sign in with Apple: accepted token audiences (comma-separated bundle ids).
# Add host.exp.Exponent only while testing in Expo Go.
APPLE_BUNDLE_IDS=com.tatsianas.todomobile
