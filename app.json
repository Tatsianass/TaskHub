{
  "expo": {
    "name": "TaskHub",
    "slug": "todo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "todomobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-tinted.png"
      },
      "bundleIdentifier": "com.tatsianas.todomobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tatsianas.todomobile"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14121F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TaskHubToday",
              "displayName": "TaskHub: Сегодня",
              "description": "Три ближайшие задачи на сегодня",
              "ios": { "supportedFamilies": ["systemMedium"] }
            },
            {
              "name": "TaskHubNext",
              "displayName": "TaskHub: Сейчас",
              "description": "Самая важная задача и прогресс дня",
              "ios": { "supportedFamilies": ["systemSmall"] }
            },
            {
              "name": "TaskHubMatrix",
              "displayName": "TaskHub: Матрица",
              "description": "Количество задач в квадрантах Эйзенхауэра",
              "ios": { "supportedFamilies": ["systemSmall"] }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
