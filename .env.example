# Where data lives. Default (unset) = 'local': on the device, no server, no sign-in.
# Set to 'server' to use the API in server/ (then EXPO_PUBLIC_API_URL is required).
#EXPO_PUBLIC_STORAGE_MODE=server

# Base URL of the API server in server/ (see server/.env.example for its PORT).
# Pick the address the app can reach the server at:
#   iOS simulator / web:  http://localhost:4000
#   Android emulator:     http://10.0.2.2:4000
#   Physical device:      http://<your-computer-LAN-IP>:4000
#EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=
